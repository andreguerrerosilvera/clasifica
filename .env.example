# Copia este archivo como .env.local y rellena los valores de AdSense (ver docs/anuncios.md).
# Sin ID de editor no se carga AdSense y los banners no se muestran
# (en `npm run dev` se ven recuadros de prueba en su lugar).

# ID de editor: AdSense → Cuenta → Información de la cuenta
VITE_ADSENSE_CLIENT=

# data-ad-slot de cada bloque de anuncios de display (tamaño fijo)
# clasifica-inicio, 320×100
VITE_ADSENSE_SLOT_HOME=
# clasifica-nivel-completado, 320×100
VITE_ADSENSE_SLOT_WIN=
# clasifica-lateral, 160×600
VITE_ADSENSE_SLOT_SIDE=

# on = anuncios de prueba de Google (para probar sin generar impresiones reales)
VITE_ADS_TEST=
# on = mostrar los recuadros de prueba también en el build de producción
VITE_ADS_PLACEHOLDER=

# PostHog (analíticas). Solo se activa en clasifica.andregames.co.
# Project API key: PostHog → Settings → Project → Project API key (empieza por phc_)
VITE_POSTHOG_KEY=
# https://us.i.posthog.com (región EE. UU.) o https://eu.i.posthog.com (región UE)
VITE_POSTHOG_HOST=

# Lista de correo (Brevo). Las usa la función netlify/functions/subscribe.ts, no el navegador:
# configúralas en Netlify → Project configuration → Environment variables (sin prefijo VITE_).
# Clave: Brevo → SMTP & API → API Keys
BREVO_API_KEY=
# Número de la lista: Brevo → Contacts → Lists
BREVO_LIST_ID=
